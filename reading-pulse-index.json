---
layout: null
permalink: /reading-pulse-index.json
sitemap: false
---
{% assign default_language = site.data.site_identity.settings.default_language %}
{
  "timezone": {{ site.timezone | default: 'UTC' | jsonify }},
  "posts": [
    {% assign separator = '' %}
    {% for post in site.posts %}
      {% assign language = post.lang | default: default_language %}
      {% if language == default_language %}
        {{ separator }}{
          "slug": {{ post.slug | default: post.title | slugify | jsonify }},
          "title": {{ post.title | jsonify }},
          "path": {{ post.url | relative_url | jsonify }},
          "url": {{ post.url | jsonify }},
          "translationKey": {{ post.translation_key | default: post.slug | jsonify }}
        }
        {% assign separator = ',' %}
      {% endif %}
    {% endfor %}
  ],
  "wiki": [
    {% for entry in site.wiki %}
      {
        "title": {{ entry.title | jsonify }},
        "path": {{ entry.url | relative_url | jsonify }},
        "url": {{ entry.url | jsonify }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
